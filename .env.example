# ==============================================================================
# Aura Living — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real credentials, production keys, or client secrets to source control.

# Authentication Secret (Required)
# Generate with: openssl rand -hex 32 or npx auth secret
AUTH_SECRET=your-server-secret-at-least-32-chars

# Base application URL for Auth.js callbacks
AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Optional for local email/password testing, required for Google Sign-In)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Persistent Database URL (Optional - defaults to local file database at data/db.json)
# Compatible with PostgreSQL or LibSQL
DATABASE_URL=
